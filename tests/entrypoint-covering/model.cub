type bit = Zero | One
array A[proc] : bit
init (i) { A[i] = Zero }
unsafe (i) { A[i] = One }

transition plain (i) requires { A[i] = Zero } { A[i] := Zero; }

transition enter (i) requires { A[i] = Zero } { A[i] := Zero; }
triggers inner (i)
triggered transition inner (i) requires { A[i] = Zero } { A[i] := Zero; }
triggers inner (i) or yields

transition recursive_entry (i) requires { A[i] = One } { A[i] := One; }
triggers recursive_entry (i) or yields
