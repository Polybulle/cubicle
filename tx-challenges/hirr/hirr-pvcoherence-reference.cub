DirL1RpMsg_Dst=dst && L1_State[dst]=L1CACHE_IM_A}
{
DirL1RpMsg_Cmd:=REPLY_NONE;
L1_State[dst]:=L1CACHE_M;
Unblock_Cmd:=UNBLOCK;
Unblock_Src:=dst;  
