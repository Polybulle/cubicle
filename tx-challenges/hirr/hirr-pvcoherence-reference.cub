}

transition L1_handle_upgrade_reply_from_L2_in_IM_AD (dst)
requires {Sort[dst]=Proc && DirL1RpMsg_Cmd=UPGRADE_REPLY && 
DirL1RpMsg_Dst=dst && L1_State[dst]=L1CACHE_IM_AD}
{
DirL1RpMsg_Cmd:=REPLY_NONE;
